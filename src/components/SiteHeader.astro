---
import { assets, navItems } from "../data/site";

// Nav hrefs end in a slash ("/about/"), so add one if the URL lacks it.
const currentPath = Astro.url.pathname.replace(/\/?$/, "/");
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="brand" href="/" aria-label="CASS Lab home">
      <img class="brand-mark" src={assets.logo} alt="" width="48" height="48" />
      <span class="brand-name">CASS Lab</span>
    </a>
    <nav class="primary-nav" aria-label="Primary navigation">
      {navItems.map((item) => {
        const isActive = item.href === currentPath;
        return (
          <a class:list={["nav-link", isActive && "is-active"]} href={item.href} aria-current={isActive ? "page" : undefined}>
            {item.label}
          </a>
        );
      })}
    </nav>
  </div>
</header>
