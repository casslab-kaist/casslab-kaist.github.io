---
import { getEntry } from "astro:content";
import { Building2, GraduationCap, IdCard, Mail } from "@lucide/astro";
import CourseCard from "../components/CourseCard.astro";
import TimelineList from "../components/TimelineList.astro";
import Layout from "../layouts/Layout.astro";

// Everything on this page comes from src/data/pi.yaml.
const pi = (await getEntry("pi", "pi"))!.data;
const linkIcons = { building: Building2, "graduation-cap": GraduationCap, "id-card": IdCard };
---

<Layout title="Jongsik Christian Yi | CASS Lab" description="Principal Investigator profile for CASS Lab at KAIST STP.">
  <main id="content">
    <section class="profile-hero" aria-labelledby="pi-title">
      <figure class="profile-hero__portrait">
        <img src={pi.portrait} alt="Portrait of Jongsik Christian Yi" width="341" height="512" />
      </figure>
      <div class="profile-hero__copy">
        <h1 id="pi-title">{pi.name}</h1>
        <p class="profile-hero__title">{pi.title}</p>
        <p class="profile-hero__appointment">{pi.appointment}</p>
        <div class="rich-copy">
          {pi.bio.map((paragraph) => <p>{paragraph}</p>)}
        </div>
        <div class="profile-links" aria-label="Profile links">
          {pi.links.map((link) => {
            const Icon = linkIcons[link.icon];
            return (
              <a href={link.url} target="_blank" rel="noopener noreferrer" class="profile-link">
                <Icon aria-hidden="true" size={16} />
                <span>{link.label}</span>
              </a>
            );
          })}
        </div>
        <div class="profile-contact" aria-label="Contact emails">
          <Mail aria-hidden="true" size={16} />
          {pi.emails.map((email, index) => (
            <>
              <a href={`mailto:${email}`} class="profile-email">{email}</a>
              {index < pi.emails.length - 1 && (
                <span class="profile-contact__separator" aria-hidden="true">•</span>
              )}
            </>
          ))}
        </div>
      </div>
    </section>

    <section class="page-section" aria-labelledby="scholarship-heading">
      <div class="section-shell pi-intro-section">
        <div class="section-heading">
          <h2 id="scholarship-heading">Publications & Academic Service</h2>
        </div>
        <div class="rich-copy pi-long-bio">
          {pi.longBio.map((paragraph) => <p set:html={paragraph} />)}
        </div>
      </div>
    </section>

    <section class="page-section page-section--warm" aria-labelledby="appointments-heading">
      <div class="section-shell">
        <div class="section-heading">
          <h2 id="appointments-heading">Academic Appointments</h2>
        </div>
        <TimelineList items={pi.appointments} highlightFirst />
      </div>
    </section>

    <section class="page-section" aria-labelledby="education-heading">
      <div class="section-shell">
        <div class="section-heading">
          <h2 id="education-heading">Education</h2>
        </div>
        <TimelineList items={pi.education} />
      </div>
    </section>

    <section class="page-section page-section--warm" aria-labelledby="interests-heading">
      <div class="section-shell">
        <div class="section-heading">
          <h2 id="interests-heading">Teaching</h2>
        </div>
        <div class="teaching-records">
          {pi.teaching.map((group) => {
            const headingId = `${group.institution.toLowerCase().replaceAll(" ", "-")}-pi-heading`;
            return (
              <section class="course-group" aria-labelledby={headingId}>
                <div class="course-group__heading">
                  <h3 id={headingId}>{group.institution}</h3>
                </div>
                <div class="course-list">
                  {group.courses.map((course) => <CourseCard course={course} />)}
                </div>
              </section>
            );
          })}
        </div>
      </div>
    </section>

    <section class="page-section" aria-labelledby="awards-heading">
      <div class="section-shell">
        <div class="section-heading">
          <h2 id="awards-heading">Awards, Fellowships, and Grants (Selected)</h2>
        </div>
        <div class="award-list">
          {pi.awards.map((award) => (
            <article class="award-item">
              <div>
                <h3>{award.title}</h3>
                <p>{award.organization}</p>
              </div>
              <span>{award.year}</span>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="page-section page-section--warm" aria-labelledby="gallery-heading">
      <div class="section-shell">
        <div class="section-heading">
          <h2 id="gallery-heading">Gallery</h2>
        </div>
        <div class="gallery-grid">
          {pi.gallery.map((photo) => (
            <figure>
              <img src={photo.image} alt={photo.alt} />
            </figure>
          ))}
        </div>
      </div>
    </section>
  </main>
</Layout>
