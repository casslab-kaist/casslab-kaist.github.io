---
import { getCollection } from "astro:content";
import Hero from "../components/Hero.astro";
import MemberList from "../components/MemberList.astro";
import Layout from "../layouts/Layout.astro";
import { assets } from "../data/site";

// One group per file in src/data/members/, sorted by each file's `order`.
const memberGroups = (await getCollection("members"))
  .sort((a, b) => a.data.order - b.data.order)
  .map((entry) => ({ id: entry.id, ...entry.data }));
---

<Layout title="Members | CASS Lab" description="PhD and MS students, research assistants, and alumni of CASS Lab.">
  <Hero title="Members" image={assets.membersHero} />
  <main class="page-main" id="content">
    <div class="section-shell member-sections">
      {
        memberGroups.map((group) => (
          <section id={group.id} aria-labelledby={`${group.id}-heading`}>
            <div class="section-heading">
              <h2 id={`${group.id}-heading`}>{group.title}</h2>
            </div>
            <MemberList members={group.members} />
          </section>
        ))
      }
    </div>
  </main>
</Layout>
