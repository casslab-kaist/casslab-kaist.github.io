---
import Hero from "../components/Hero.astro";
import MemberList from "../components/MemberList.astro";
import Layout from "../layouts/Layout.astro";
import { alumni, assets, msStudents, phdStudents, researchAssistants } from "../data/site";

const memberGroups = [
  { id: "phd-students", title: "PhD Students", members: phdStudents },
  { id: "ms-students", title: "MS Students", members: msStudents },
  { id: "research-assistants", title: "Research Assistants", members: researchAssistants },
  { id: "alumni", title: "Alumni", members: alumni },
];
---

<Layout title="Members | CASS Lab" description="PhD and MS students, research assistants, and alumni of CASS Lab.">
  <Hero title="Members" image={assets.membersHero} />
  <main class="page-main" id="content">
    <div class="section-shell member-sections">
      {
        memberGroups.map((group) => (
          <section id={group.id} aria-labelledby={`${group.id}-heading`}>
            <div class="section-heading">
              <h2 id={`${group.id}-heading`}>{group.title}</h2>
            </div>
            <MemberList members={group.members} />
          </section>
        ))
      }
    </div>
  </main>
</Layout>
