---
import { getEntry } from "astro:content";
import { GraduationCap, Landmark, PawPrint, Scale, ShieldCheck } from "@lucide/astro";
import Hero from "../components/Hero.astro";
import Layout from "../layouts/Layout.astro";
import { assets, assetSources, researchThemes } from "../data/site";

const { projects } = (await getEntry("projects", "projects"))!.data;

const themeIcons = [Scale, GraduationCap, PawPrint, Landmark, ShieldCheck];
---

<Layout title="Research | CASS Lab" description="Research themes, areas, and current projects at CASS Lab.">
  <Hero title="Research" image={assets.researchHero} imageSource={assetSources.researchHero} />
  <main id="content">
    <section class="page-section" aria-labelledby="themes-heading">
      <div class="section-shell">
        <div class="section-heading section-heading--center">
          <h2 id="themes-heading">Research Themes</h2>
        </div>
        <div class="research-map" aria-label="CASS Lab research themes">
          {researchThemes.map((theme, index) => {
            const Icon = themeIcons[index];
            return (
              <article class={`theme-card theme-card--${index + 1}`}>
                <Icon class="theme-card__icon" aria-hidden="true" size={24} />
                <h3>{theme.title}</h3>
                <p class="small-label">Keywords</p>
                <p>{theme.keywords}</p>
              </article>
            );
          })}
          <article class="theme-card theme-card--core">
            <img src="/hub.svg" alt="" class="theme-card__hub" aria-hidden="true" />
            <h3>Chinese &amp; Asian Science and Technology</h3>
            <p class="small-label">Core Research Hub</p>
          </article>
        </div>
      </div>
    </section>

    <section class="page-section page-section--warm" aria-labelledby="projects-heading">
      <div class="section-shell">
        <div class="section-heading section-heading--row">
          <h2 id="projects-heading">Current Projects</h2>
          <p class="small-label">Active Grants</p>
        </div>
        <div class="project-list">
          {projects.map((project) => (
            <article class="project-card project-card--summary">
              <div class="project-card__body">
                <h3>{project.title}</h3>
              </div>
              <dl class="project-card__facts">
                <div>
                  <dt>Funding Agency</dt>
                  <dd>{project.fundingAgency}</dd>
                </div>
                <div>
                  <dt>Duration</dt>
                  <dd>{project.duration}</dd>
                </div>
              </dl>
            </article>
          ))}
        </div>
      </div>
    </section>
  </main>
</Layout>
